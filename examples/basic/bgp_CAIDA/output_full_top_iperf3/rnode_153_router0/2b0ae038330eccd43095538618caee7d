log "/var/log/bird.log" all;
router id 10.0.0.71;
ipv4 table t_direct;
protocol device {
}
protocol kernel {
    ipv4 {
        import all;
        export all;
    };
    learn;
}
protocol direct local_nets {
    ipv4 {
        table t_direct;
        import all;
    };

    interface "net0";

}
define LOCAL_COMM = (153, 0, 0);
define CUSTOMER_COMM = (153, 1, 0);
define PEER_COMM = (153, 2, 0);
define PROVIDER_COMM = (153, 3, 0);
protocol bfd  {
    interface "net0" {
        min rx interval 100 ms;
        min tx interval 100 ms;
        multiplier 3;
    };

    interface "ix102" {
        min rx interval 100 ms;
        min tx interval 100 ms;
        multiplier 3;
    };

}
ipv4 table t_bgp;
protocol pipe {
    table t_bgp;
    peer table master4;
    import all;
    export all;
}
protocol pipe {
    table t_direct;
    peer table t_bgp;
    import all;
    export filter { bgp_large_community.add(LOCAL_COMM); bgp_local_pref = 40; accept; };
}
protocol bgp x_as51 {
    ipv4 {
        table t_bgp;
        import filter {
            bgp_large_community.add(PROVIDER_COMM);
            bgp_local_pref = 10;
            accept;
        };
        export all;
        next hop self;
    };
    local 10.102.0.153 as 153;
    neighbor 10.102.0.51 as 51;
    grpc transport yes;
    bfd yes;
}
protocol bgp x_as152 {
    ipv4 {
        table t_bgp;
        import filter {
            bgp_large_community.add(CUSTOMER_COMM);
            bgp_local_pref = 30;
            accept;
        };
        export all;
        next hop self;
    };
    local 10.102.0.153 as 153;
    neighbor 10.102.0.152 as 152;
    grpc transport yes;
    bfd yes;
}

