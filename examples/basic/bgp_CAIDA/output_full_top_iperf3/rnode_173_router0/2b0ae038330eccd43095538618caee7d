define LOCAL_COMM = (173, 0, 0);
define CUSTOMER_COMM = (173, 1, 0);
define PEER_COMM = (173, 2, 0);
define PROVIDER_COMM = (173, 3, 0);
protocol bfd  {
    interface "net0" {
        min rx interval 100 ms;
        min tx interval 100 ms;
        multiplier 3;
    };

    interface "ix101" {
        min rx interval 100 ms;
