ipv4 table t_bgp;
protocol pipe {
    table t_bgp;
    peer table master4;
    import all;
    export all;
}
protocol pipe {
    table t_direct;
    peer table t_bgp;
    import all;
    export filter { bgp_large_community.add(LOCAL_COMM); bgp_local_pref = 40; accept; };
}
protocol bgp x_as91 {
    ipv4 {
        table t_bgp;
        import filter {
            bgp_large_community.add(PROVIDER_COMM);
            bgp_local_pref = 10;
            accept;
        };
        export all;
        next hop self;
    };
    local 10.106.0.173 as 173;
    neighbor 10.106.0.91 as 91;
    grpc transport yes;
    bfd yes;
}
protocol bgp x_as171 {
    ipv4 {
        table t_bgp;
